{
  "manifest_version": 3,
  "name": "WhatsApp Hate Speech Detector",
  "version": "1.0",
  "description": "Detect and highlight hate/offensive messages in WhatsApp Web",
  "permissions": ["scripting", "storage", "activeTab"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://instagram.com/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*","https://instagram.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
